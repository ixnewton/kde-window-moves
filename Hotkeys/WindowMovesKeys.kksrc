[kde-window-moves.desktop][Global Shortcuts]
_launch=
expandP=Ctrl+Shift+L
heightM=Ctrl+Shift+E
heightP=Ctrl+Shift+R
minimize=Ctrl+Alt+M
moveC=Ctrl+Shift+C
moveL=Ctrl+Shift+Left
moveR=Ctrl+Shift+Right
topM=Ctrl+Shift+Up
topP=Ctrl+Shift+Down
widthM=Ctrl+{
widthP=Ctrl+}
zoomM=Ctrl+Shift+Q
zoomP=Ctrl+Shift+W
